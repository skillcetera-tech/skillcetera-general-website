{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "studio\\..*"
        }
      ],
      "destination": "/pages/studio.html"
    },
    {
      "source": "/((?!assets|src|fonts|vendor|data|_vercel|favicon|api).*)",
      "has": [
        {
          "type": "host",
          "value": "studio\\..*"
        }
      ],
      "destination": "/pages/studio.html"
    },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/esc", "destination": "/pages/esc.html" },
    { "source": "/tedx", "destination": "/pages/tedx.html" },
    { "source": "/projects", "destination": "/pages/projects.html" },
    { "source": "/join", "destination": "/pages/join.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/studio", "destination": "/pages/studio.html" }
  ]
}

